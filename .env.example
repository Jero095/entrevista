# Copiar a .env y ajustar. SQL Server exige contraseñas complejas
# (mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos).

# Administrador: lo usa el ETL para crear el esquema y cargar datos.
DB_PASSWORD=Alarmas_Dev_2026!
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_NAME=alarmas
DB_DRIVER=ODBC Driver 18 for SQL Server

# Usuario de solo lectura de la API (lo crea `python -m etl init-db`).
DB_API_USER=api_lectura
DB_API_PASSWORD=Alarmas_Api_2026!

# API key para consumir /api/v1 (header X-API-Key). Vacía = API abierta (solo desarrollo).
API_KEY=dev-api-key-cambiar
# Orígenes permitidos por CORS (frontend), separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
